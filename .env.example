# Server Configuration
PORT=5005
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5005

# Database Configuration (MySQL / Aiven / TiDB / Railway)
# Option A: Full Connection URI
DATABASE_URL=
# Option B: Individual Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_companion
DB_SSL=false
DB_CONNECTION_LIMIT=30

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_change_me

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Cloudinary Media Storage (Voice Notes & Avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ElevenLabs Voice Synthesis & Cloning (Optional)
ELEVENLABS_API_KEY=
